{
  "name": "amazing-multicodex",
  "displayName": "Amazing MultiCodex",
  "description": "A control plane for coordinating multiple Codex sessions inside VS Code.",
  "version": "0.1.0",
  "publisher": "amazing-multicodex",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Burburton/amazing-multicodex.git"
  },
  "homepage": "https://github.com/Burburton/amazing-multicodex#readme",
  "bugs": {
    "url": "https://github.com/Burburton/amazing-multicodex/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "MultiCodex creates Git worktrees and runs configured validation commands."
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "activationEvents": [
    "onView:amazingMultiCodex.projects",
    "onCommand:amazingMultiCodex.addProject",
    "onCommand:amazingMultiCodex.refreshProjects",
    "onCommand:amazingMultiCodex.showProjectDetails",
    "onCommand:amazingMultiCodex.editProject",
    "onCommand:amazingMultiCodex.removeProject",
    "onCommand:amazingMultiCodex.openProject",
    "onCommand:amazingMultiCodex.moveTask",
    "onCommand:amazingMultiCodex.configureTaskAgents",
    "onCommand:amazingMultiCodex.retryAgentStage",
    "onCommand:amazingMultiCodex.createTask",
    "onCommand:amazingMultiCodex.editTask",
    "onCommand:amazingMultiCodex.refreshTasks",
    "onCommand:amazingMultiCodex.showRuntimeStatus",
    "onCommand:amazingMultiCodex.queueTask",
    "onCommand:amazingMultiCodex.dispatchQueue",
    "onCommand:amazingMultiCodex.startTask",
    "onCommand:amazingMultiCodex.resumeTask",
    "onCommand:amazingMultiCodex.reconnectRunningTasks",
    "onCommand:amazingMultiCodex.steerTask",
    "onCommand:amazingMultiCodex.showActivity",
    "onCommand:amazingMultiCodex.showApprovalInbox",
    "onCommand:amazingMultiCodex.showTaskDetails",
    "onCommand:amazingMultiCodex.cancelTask",
    "onCommand:amazingMultiCodex.validateTask",
    "onCommand:amazingMultiCodex.showChanges",
    "onCommand:amazingMultiCodex.integrateTask",
    "onCommand:amazingMultiCodex.recoverIntegration",
    "onCommand:amazingMultiCodex.addDependency",
    "onCommand:amazingMultiCodex.removeDependency",
    "onCommand:amazingMultiCodex.releaseWorkspace",
    "onCommand:amazingMultiCodex.deleteTask"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Amazing MultiCodex",
      "properties": {
        "amazingMultiCodex.codexExecutable": {
          "type": "string",
          "maxLength": 4096,
          "default": "codex",
          "description": "Codex CLI executable used to start App Server."
        },
        "amazingMultiCodex.defaultModel": {
          "type": "string",
          "maxLength": 1000,
          "default": "",
          "description": "Optional model override for newly started tasks. Empty uses the Codex default."
        },
        "amazingMultiCodex.requestTimeoutMs": {
          "type": "integer",
          "default": 30000,
          "minimum": 1000,
          "maximum": 300000,
          "description": "Timeout for Codex App Server requests in milliseconds."
        },
        "amazingMultiCodex.baseRef": {
          "type": "string",
          "maxLength": 1024,
          "default": "HEAD",
          "description": "Git ref used as the base for new task worktrees."
        },
        "amazingMultiCodex.concurrencyLimit": {
          "type": "integer",
          "default": 2,
          "minimum": 1,
          "maximum": 16,
          "description": "Maximum number of concurrently running tasks."
        },
        "amazingMultiCodex.maxActivityCharacters": {
          "type": "integer",
          "default": 32000,
          "minimum": 1000,
          "maximum": 200000,
          "description": "Maximum number of characters retained for one streamed agent message."
        },
        "amazingMultiCodex.validationTimeoutMs": {
          "type": "integer",
          "default": 900000,
          "minimum": 1000,
          "maximum": 3600000,
          "description": "Timeout applied to each validation command in milliseconds."
        },
        "amazingMultiCodex.validationCommands": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "default": [
            {
              "label": "Git whitespace check",
              "executable": "git",
              "args": [
                "diff",
                "--check"
              ]
            }
          ],
          "items": {
            "type": "object",
            "required": [
              "label",
              "executable",
              "args"
            ],
            "properties": {
              "label": {
                "type": "string",
                "maxLength": 200
              },
              "executable": {
                "type": "string",
                "maxLength": 4096
              },
              "args": {
                "type": "array",
                "maxItems": 200,
                "items": {
                  "type": "string",
                  "maxLength": 10000
                }
              }
            }
          },
          "description": "Ordered validation commands run inside a completed task worktree."
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "amazingMultiCodex.projects",
          "name": "MultiCodex Projects",
          "when": "true"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "amazingMultiCodex.projects",
        "contents": "Manage repositories and project-level task health.\n[Add a Git project](command:amazingMultiCodex.addProject)\n[Refresh projects](command:amazingMultiCodex.refreshProjects)",
        "when": "amazingMultiCodex.hasProjects == false"
      }
    ],
    "commands": [
      {
        "command": "amazingMultiCodex.addProject",
        "title": "MultiCodex: Add Project",
        "icon": "$(repo-create)"
      },
      {
        "command": "amazingMultiCodex.refreshProjects",
        "title": "MultiCodex: Refresh Projects",
        "icon": "$(refresh)"
      },
      {
        "command": "amazingMultiCodex.showProjectDetails",
        "title": "MultiCodex: Show Project Details",
        "icon": "$(dashboard)"
      },
      {
        "command": "amazingMultiCodex.editProject",
        "title": "MultiCodex: Edit Project",
        "icon": "$(edit)"
      },
      {
        "command": "amazingMultiCodex.removeProject",
        "title": "MultiCodex: Remove Project",
        "icon": "$(remove)"
      },
      {
        "command": "amazingMultiCodex.openProject",
        "title": "MultiCodex: Open Project Repository",
        "icon": "$(folder-opened)"
      },
      {
        "command": "amazingMultiCodex.moveTask",
        "title": "MultiCodex: Move Task to Project",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "amazingMultiCodex.configureTaskAgents",
        "title": "MultiCodex: Configure Task Agents",
        "icon": "$(organization)"
      },
      {
        "command": "amazingMultiCodex.retryAgentStage",
        "title": "MultiCodex: Retry Failed Agent Stage",
        "icon": "$(debug-restart)"
      },
      {
        "command": "amazingMultiCodex.createTask",
        "title": "MultiCodex: Create Task"
      },
      {
        "command": "amazingMultiCodex.refreshTasks",
        "title": "MultiCodex: Refresh Tasks"
      },
      {
        "command": "amazingMultiCodex.editTask",
        "title": "MultiCodex: Edit Draft Task",
        "icon": "$(edit)"
      },
      {
        "command": "amazingMultiCodex.showRuntimeStatus",
        "title": "MultiCodex: Show Runtime Status",
        "icon": "$(pulse)"
      },
      {
        "command": "amazingMultiCodex.queueTask",
        "title": "MultiCodex: Queue or Retry Task",
        "icon": "$(debug-restart)"
      },
      {
        "command": "amazingMultiCodex.dispatchQueue",
        "title": "MultiCodex: Dispatch Queue",
        "icon": "$(run-all)"
      },
      {
        "command": "amazingMultiCodex.startTask",
        "title": "MultiCodex: Start Task",
        "icon": "$(play)"
      },
      {
        "command": "amazingMultiCodex.resumeTask",
        "title": "MultiCodex: Reconnect / Resume Task",
        "icon": "$(debug-continue)"
      },
      {
        "command": "amazingMultiCodex.reconnectRunningTasks",
        "title": "MultiCodex: Reconnect All Running Tasks",
        "icon": "$(run-all)"
      },
      {
        "command": "amazingMultiCodex.steerTask",
        "title": "MultiCodex: Send Follow-up",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "amazingMultiCodex.showActivity",
        "title": "MultiCodex: Show Task Activity",
        "icon": "$(history)"
      },
      {
        "command": "amazingMultiCodex.showApprovalInbox",
        "title": "MultiCodex: Show Approval Inbox",
        "icon": "$(verified)"
      },
      {
        "command": "amazingMultiCodex.showTaskDetails",
        "title": "MultiCodex: Show Task Details",
        "icon": "$(preview)"
      },
      {
        "command": "amazingMultiCodex.cancelTask",
        "title": "MultiCodex: Cancel Task",
        "icon": "$(stop-circle)"
      },
      {
        "command": "amazingMultiCodex.validateTask",
        "title": "MultiCodex: Validate Task",
        "icon": "$(beaker)"
      },
      {
        "command": "amazingMultiCodex.showChanges",
        "title": "MultiCodex: Show Task Changes",
        "icon": "$(diff)"
      },
      {
        "command": "amazingMultiCodex.integrateTask",
        "title": "MultiCodex: Integrate Task",
        "icon": "$(git-merge)"
      },
      {
        "command": "amazingMultiCodex.recoverIntegration",
        "title": "MultiCodex: Recover Interrupted Integration",
        "icon": "$(history)"
      },
      {
        "command": "amazingMultiCodex.addDependency",
        "title": "MultiCodex: Add Prerequisite",
        "icon": "$(references)"
      },
      {
        "command": "amazingMultiCodex.removeDependency",
        "title": "MultiCodex: Remove Prerequisite",
        "icon": "$(remove)"
      },
      {
        "command": "amazingMultiCodex.releaseWorkspace",
        "title": "MultiCodex: Release Worktree",
        "icon": "$(trash)"
      },
      {
        "command": "amazingMultiCodex.deleteTask",
        "title": "MultiCodex: Delete Task",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "amazingMultiCodex.addProject",
          "when": "view == amazingMultiCodex.projects",
          "group": "navigation"
        },
        {
          "command": "amazingMultiCodex.refreshProjects",
          "when": "view == amazingMultiCodex.projects",
          "group": "navigation"
        },
        {
          "command": "amazingMultiCodex.createTask",
          "when": "view == amazingMultiCodex.projects",
          "group": "navigation"
        },
        {
          "command": "amazingMultiCodex.refreshTasks",
          "when": "view == amazingMultiCodex.projects",
          "group": "navigation"
        },
        {
          "command": "amazingMultiCodex.showRuntimeStatus",
          "when": "view == amazingMultiCodex.projects",
          "group": "navigation"
        },
        {
          "command": "amazingMultiCodex.dispatchQueue",
          "when": "view == amazingMultiCodex.projects",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "amazingMultiCodex.createTask",
          "when": "view == amazingMultiCodex.projects && viewItem == multicodexProject",
          "group": "inline"
        },
        {
          "command": "amazingMultiCodex.showProjectDetails",
          "when": "view == amazingMultiCodex.projects && viewItem == multicodexProject",
          "group": "navigation@1"
        },
        {
          "command": "amazingMultiCodex.editProject",
          "when": "view == amazingMultiCodex.projects && viewItem == multicodexProject",
          "group": "navigation@2"
        },
        {
          "command": "amazingMultiCodex.openProject",
          "when": "view == amazingMultiCodex.projects && viewItem == multicodexProject",
          "group": "navigation@3"
        },
        {
          "command": "amazingMultiCodex.removeProject",
          "when": "view == amazingMultiCodex.projects && viewItem == multicodexProject",
          "group": "navigation@99"
        },
        {
          "command": "amazingMultiCodex.editTask",
          "when": "view == amazingMultiCodex.projects && viewItem == multicodexTask.draft",
          "group": "inline"
        },
        {
          "command": "amazingMultiCodex.showTaskDetails",
          "when": "view == amazingMultiCodex.projects && viewItem =~ /^multicodexTask\\./",
          "group": "navigation@1"
        },
        {
          "command": "amazingMultiCodex.queueTask",
          "when": "view == amazingMultiCodex.projects && (viewItem == multicodexTask.draft || viewItem == multicodexTask.failed || viewItem == multicodexTask.cancelled || viewItem == multicodexTask.blocked)",
          "group": "inline"
        },
        {
          "command": "amazingMultiCodex.startTask",
          "when": "view == amazingMultiCodex.projects && viewItem == multicodexTask.queued",
          "group": "inline"
        },
        {
          "command": "amazingMultiCodex.resumeTask",
          "when": "view == amazingMultiCodex.projects && viewItem == multicodexTask.running",
          "group": "inline"
        },
        {
          "command": "amazingMultiCodex.steerTask",
          "when": "view == amazingMultiCodex.projects && viewItem == multicodexTask.running",
          "group": "navigation"
        },
        {
          "command": "amazingMultiCodex.showActivity",
          "when": "view == amazingMultiCodex.projects && viewItem =~ /^multicodexTask\\./",
          "group": "navigation"
        },
        {
          "command": "amazingMultiCodex.cancelTask",
          "when": "view == amazingMultiCodex.projects && (viewItem == multicodexTask.queued || viewItem == multicodexTask.running || viewItem == multicodexTask.awaitingApproval)",
          "group": "inline"
        },
        {
          "command": "amazingMultiCodex.validateTask",
          "when": "view == amazingMultiCodex.projects && viewItem == multicodexTask.validating",
          "group": "inline"
        },
        {
          "command": "amazingMultiCodex.showChanges",
          "when": "view == amazingMultiCodex.projects && (viewItem == multicodexTask.validating || viewItem == multicodexTask.readyForReview || viewItem == multicodexTask.completed || viewItem == multicodexTask.failed || viewItem == multicodexTask.cancelled || viewItem == multicodexTask.blocked || viewItem == multicodexTask.blocked.integration)",
          "group": "inline"
        },
        {
          "command": "amazingMultiCodex.integrateTask",
          "when": "view == amazingMultiCodex.projects && (viewItem == multicodexTask.readyForReview || viewItem == multicodexTask.blocked.integration)",
          "group": "inline"
        },
        {
          "command": "amazingMultiCodex.recoverIntegration",
          "when": "view == amazingMultiCodex.projects && viewItem == multicodexTask.integrating",
          "group": "inline"
        },
        {
          "command": "amazingMultiCodex.addDependency",
          "when": "view == amazingMultiCodex.projects && viewItem == multicodexTask.draft",
          "group": "navigation"
        },
        {
          "command": "amazingMultiCodex.removeDependency",
          "when": "view == amazingMultiCodex.projects && viewItem == multicodexTask.draft",
          "group": "navigation"
        },
        {
          "command": "amazingMultiCodex.moveTask",
          "when": "view == amazingMultiCodex.projects && viewItem == multicodexTask.draft",
          "group": "navigation@4"
        },
        {
          "command": "amazingMultiCodex.configureTaskAgents",
          "when": "view == amazingMultiCodex.projects && viewItem == multicodexTask.draft",
          "group": "navigation@5"
        },
        {
          "command": "amazingMultiCodex.releaseWorkspace",
          "when": "view == amazingMultiCodex.projects && (viewItem == multicodexTask.completed || viewItem == multicodexTask.cancelled)",
          "group": "navigation"
        },
        {
          "command": "amazingMultiCodex.deleteTask",
          "when": "view == amazingMultiCodex.projects && (viewItem == multicodexTask.draft || viewItem == multicodexTask.readyForReview || viewItem == multicodexTask.completed || viewItem == multicodexTask.failed || viewItem == multicodexTask.cancelled || viewItem == multicodexTask.blocked || viewItem == multicodexTask.blocked.integration || viewItem == multicodexTask.deleting)",
          "group": "navigation@99"
        }
      ]
    }
  },
  "scripts": {
    "compile": "node scripts/clean-out.js && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "check": "tsc --noEmit -p ./ && npm run check:architecture && npm run check:manifest",
    "check:architecture": "node scripts/check-architecture.js",
    "check:manifest": "node scripts/check-manifest.js",
    "test": "npm run compile && node --test \"out/**/*.test.js\"",
    "package": "npm run compile && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.6.0"
  }
}
